# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# OpenRouter — powers the LangChain agent (agent/langchain_agent.py,
# agent/daily_sweep.py), recipe generation + recipe images (agent/recipes.py),
# and chat (agent/chat.py). Without this, those features fail gracefully
# (an error in the UI) rather than crashing.
OPENROUTER_API_KEY=
# Optional: override the default model slug (see agent/langchain_agent.py).
# OPENROUTER_MODEL=

# Used by capture/webcam_capture.py — matches the port docker-compose.yml
# maps the backend to on this machine
BACKEND_URL=http://localhost:8010

# cv/ (webcam capture pipeline, run locally — see cv/README.md) reads its
# own CV_BACKEND / CV_MODEL_PATH / CV_CONF_THRESHOLD / CV_IOU_THRESHOLD env
# vars directly; not required to just run the frontend/backend dashboard.
